rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Access comes from users/{uid}: {role: 'admin'|'user', access: {companyId: [tab ids]}, active}.
    // Signing in is not enough on its own: the account needs an active users doc,
    // which only an admin can create (from the Users tab).
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function active() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().active == true;
    }
    function admin() {
      return active() && me().role == 'admin';
    }
    function tabs(co) {
      return me().get('access', {}).get(co, []);
    }
    // Can open the company at all: admin, or at least one tab ticked for it.
    function member(co) {
      return active() && (me().role == 'admin' || tabs(co).size() > 0);
    }
    // Writes follow the tabs that make them.
    function tab(co, id) {
      return active() && (me().role == 'admin' || id in tabs(co));
    }

    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || admin();
      allow write: if admin();
    }

    match /companies/{co} {
      match /orders/{id} {
        allow read: if member(co);
        allow write: if tab(co, 'orders') || tab(co, 'incentives');
      }

      // Bulk upload on Sale Orders adds new salesmen/channels; editing them is Settings.
      match /reps/{id} {
        allow read: if member(co);
        allow create: if tab(co, 'orders') || tab(co, 'settings');
        allow update, delete: if tab(co, 'settings');
      }
      match /channels/{id} {
        allow read: if member(co);
        allow create: if tab(co, 'orders') || tab(co, 'settings');
        allow update, delete: if tab(co, 'settings');
      }

      match /meta/months {
        allow read: if member(co);
        allow write: if tab(co, 'orders');
      }
      match /meta/settings {
        allow read: if member(co);
        allow write: if tab(co, 'settings');
      }
      match /meta/expenses {
        allow read: if member(co);
        allow write: if tab(co, 'expenses');
      }

      // Purchasing: masters are edited on the Masters tab, POs on the Purchase Orders tab.
      // Saving an ordered PO may also update a product's last price, and uploading PO items
      // may add products that aren't in the master yet.
      match /vendors/{id} {
        allow read: if member(co);
        allow write: if tab(co, 'masters');
      }
      match /hscodes/{id} {
        allow read: if member(co);
        allow write: if tab(co, 'masters');
      }
      match /products/{id} {
        allow read: if member(co);
        allow write: if tab(co, 'masters');
        allow create: if tab(co, 'purchase');
        allow update: if tab(co, 'purchase')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPrice', 'lastPo']);
      }
      match /purchaseOrders/{id} {
        allow read: if member(co);
        allow write: if tab(co, 'purchase');
      }
      match /meta/purchasing {
        allow read: if member(co);
        allow write: if tab(co, 'masters');
      }
    }
  }
}
