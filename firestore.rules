rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Access comes from users/{uid}: {role: 'admin'|'user', pages: [tab ids], active}.
    // Signing in is not enough on its own: the account needs an active users doc,
    // which only an admin can create (from the Users tab).
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function active() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().active == true;
    }
    function admin() {
      return active() && me().role == 'admin';
    }
    // Writes follow the tabs that make them.
    function tab(id) {
      return active() && (me().role == 'admin' || id in me().pages);
    }

    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || admin();
      allow write: if admin();
    }

    match /orders/{id} {
      allow read: if active();
      allow write: if tab('orders') || tab('incentives');
    }

    // Bulk upload on Sale Orders adds new salesmen/channels; editing them is Settings.
    match /reps/{id} {
      allow read: if active();
      allow create: if tab('orders') || tab('settings');
      allow update, delete: if tab('settings');
    }
    match /channels/{id} {
      allow read: if active();
      allow create: if tab('orders') || tab('settings');
      allow update, delete: if tab('settings');
    }

    match /meta/months {
      allow read: if active();
      allow write: if tab('orders');
    }
    match /meta/settings {
      allow read: if active();
      allow write: if tab('settings');
    }
    match /meta/expenses {
      allow read: if active();
      allow write: if tab('expenses');
    }
  }
}
